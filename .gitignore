# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Data and generated artefacts
data/
!data/.gitkeep
benchmarks/results/*.json
!benchmarks/results/.gitkeep
*.parquet
*.duckdb
*.db
*.sqlite3
logs/
*.log
!tests/**/*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
