# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
credentials.json
secrets/

# Data and generated artefacts
data/
!data/.gitkeep
# The demo writes a whole store here — partitioned parquet, a metadata
# database, raw logs and rendered reports. 70 MB after one run, and
# regenerated by `make demo`, so it is output, not source.
demo-workspace/
benchmarks/results/*.json
!benchmarks/results/.gitkeep
*.parquet
*.duckdb
*.db
*.sqlite3
logs/
*.log
!tests/**/*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
